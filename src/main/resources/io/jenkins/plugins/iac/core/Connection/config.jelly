<?jelly escape-by-default='true'?>
<j:jelly xmlns:j="jelly:core" xmlns:f="/lib/form" xmlns:c="/lib/credentials">
  <f:entry title="Connection name" field="name"><f:textbox/></f:entry>
  <f:entry title="API origin" field="url"><f:textbox checkMethod="post"/></f:entry>
  <f:entry title="Secret Text credential" field="credentialsId"><c:select/></f:entry>
  <f:entry title="Allow HTTP (local dev only)" field="allowHttp"><f:checkbox/></f:entry>
</j:jelly>
